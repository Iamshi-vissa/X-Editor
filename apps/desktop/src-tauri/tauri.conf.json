{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "X-Editor",
  "mainBinaryName": "x-editor",
  "version": "0.2.0",
  "identifier": "dev.xeditor.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix apps/desktop/ui run dev",
    "beforeBuildCommand": "npm --prefix apps/desktop/ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "X-Editor",
        "width": 1360,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0d0e12",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: https://avatars.githubusercontent.com",
        "connect-src": "ipc: http://ipc.localhost",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A fast, customisable code editor that grows into an IDE",
    "copyright": "Copyright (c) X-Editor contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
